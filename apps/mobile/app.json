{
  "expo": {
    "name": "Tap Pay Devnet",
    "slug": "onchain-payments",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "platforms": [
      "android",
      "ios"
    ],
    "android": {
      "package": "com.onchainpayments.devnet",
      "versionCode": 1,
      "allowBackup": false,
      "permissions": [
        "android.permission.INTERNET"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.onchainpayments.devnet",
      "buildNumber": "1",
      "supportsTablet": false,
      "infoPlist": {
        "LSApplicationQueriesSchemes": ["phantom"]
      }
    },
    "scheme": "tappay",
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Tap Pay to scan payment QR codes.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      "./plugins/withPaymentNfc.cjs",
      "./plugins/withPhoneTap.cjs"
    ]
  }
}
