# Public values bundled into the APK. Never put secrets in EXPO_PUBLIC_*.
EXPO_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
# Optional shared demo mint. Alternatively create/load one through the app.
# Must match the immutable Token-2022 ×2 demo profile.
EXPO_PUBLIC_AAPLX_DEMO_MINT=
# Actual deployed Devnet red packet program. Empty disables red packet operations.
# Never use the contract's undeployed local-test default ID here.
EXPO_PUBLIC_RED_PACKET_PROGRAM_ID=
